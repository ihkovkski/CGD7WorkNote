rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ต้องผ่าน Anonymous sign-in จากหน้าเว็บก่อนจึงอ่าน/เขียนได้
    function signedIn() { return request.auth != null; }

    // เดือนที่ปิดงวดแล้ว (มีเอกสาร locks/YYYY-MM) ห้ามแก้ไขข้อมูล
    function unlocked(month) {
      return !exists(/databases/$(database)/documents/locks/$(month));
    }

    match /providers/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.role in ['general', 'admin'];
      allow delete: if false;   // ใช้ "ปิดใช้งาน" แทนการลบ
    }

    // hash รหัสผ่านผู้ดูแล: อ่านได้ทีละเอกสาร (get) แต่ดึงทั้งหมด (list) ไม่ได้ และลบไม่ได้
    match /credentials/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.hash is string
        && request.resource.data.salt is string
        && request.resource.data.iterations is int;
      allow delete: if false;
    }

    match /records/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && id == request.resource.data.date + '_' + request.resource.data.providerId
        && request.resource.data.date.matches(request.resource.data.month + '-[0-9]{2}')
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && unlocked(request.resource.data.month)
        && (resource == null || unlocked(resource.data.month));
      allow delete: if signedIn() && unlocked(resource.data.month);
    }

    // การปิดงวด: สร้าง (ปิด) และลบ (เปิด) ได้ แต่แก้ไขไม่ได้
    match /locks/{month} {
      allow read: if signedIn();
      allow create: if signedIn() && month.matches('[0-9]{4}-[0-9]{2}');
      allow delete: if signedIn();
      allow update: if false;
    }

    // ประวัติการแก้ไข: เพิ่มได้อย่างเดียว ลบหรือแก้ไม่ได้
    match /logs/{id} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // ตัวเลือกในรายการ: ห้ามลบ (จำนวนตัวเลือกแต่ละหมวดต้องไม่ลดลง)
    function noShrink(f) {
      return !(f in resource.data)
        || (f in request.resource.data && request.resource.data[f].size() >= resource.data[f].size());
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && noShrink('clients') && noShrink('topics')
        && noShrink('channels') && noShrink('positions');
      allow delete: if false;
    }
  }
}
